@model IEnumerable<GarageJobCards.Models.JobCard>
@{
    ViewData["Title"] = "My Bookings";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var order = GarageJobCards.Models.JobCard.TimelineOrder;
}

<div class="page-head">
    <h1>My Bookings</h1>
    <p>Live status for every job you've booked with us.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <p style="color:#ff6b6b; margin-bottom:20px;">@TempData["Error"]</p>
}

@if (!Model.Any())
{
    <p style="color:var(--paper-dim);">No jobs booked yet - give us a call or visit the shop to get started.</p>
}

<div style="display:flex; flex-direction:column; gap:24px;">
    @foreach (var job in Model)
    {
        var currentIndex = System.Array.IndexOf(order, job.Status);
        <div class="form-card" style="max-width:760px;">
            <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;">
                <h3 style="font-family:'Oswald',sans-serif; text-transform:uppercase; font-size:18px;">
                    @job.Vehicle.Make @job.Vehicle.Model &middot; @job.Vehicle.PlateNumber
                </h3>
                <span class="status-badge status-@job.Status">@GarageJobCards.Models.JobCard.StatusLabel(job.Status)</span>
            </div>
            <div style="font-family:'Space Mono',monospace; font-size:12px; color:var(--steel); margin-top:6px;">@job.JobNumber</div>

            @if (job.Status == GarageJobCards.Models.JobStatus.Cancelled && job.CustomerDeclined)
            {
                <p style="color:#ff6b6b; font-size:13px; margin-top:14px;">You declined this quote@(string.IsNullOrEmpty(job.DeclineReason) ? "." : ": " + job.DeclineReason)</p>
                <a href="@Url.Action("Quotation","JobCard", new { id = job.Id })" class="btn-ghost" style="text-decoration:none; display:inline-block; margin-top:10px;">View Diagnostic Invoice - R@(job.TotalInclVat.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</a>
            }

            @if (job.Status != GarageJobCards.Models.JobStatus.Cancelled)
            {
                <div class="timeline">
                    @for (int i = 0; i < order.Length; i++)
                    {
                        var cls = i < currentIndex ? "done" : (i == currentIndex ? "current" : "");
                        <div class="timeline-step @cls">
                            <div class="timeline-dot"></div>
                            <div class="label">@GarageJobCards.Models.JobCard.StatusLabel(order[i])</div>
                        </div>
                    }
                </div>
            }

            @if (job.EstimatedCompletionUtc.HasValue && job.Status != GarageJobCards.Models.JobStatus.Completed && job.Status != GarageJobCards.Models.JobStatus.Cancelled)
            {
                <p style="color:var(--ice); font-family:'Space Mono',monospace; font-size:13px; margin:14px 0;">
                    Estimated completion: @job.EstimatedCompletionUtc.Value.ToLocalTime().ToString("dd MMM, HH:mm")
                    (about @job.EstimatedHours.Value.ToString("0.#") hour(s) from approval)
                </p>
            }

            @if (job.Status == GarageJobCards.Models.JobStatus.AwaitingApproval)
            {
                <div style="background:var(--oil); border:1px solid var(--steel-dim); border-radius:6px; padding:22px; margin-top:6px;">
                    <p style="margin-bottom:6px; font-family:'Oswald',sans-serif; text-transform:uppercase; letter-spacing:0.5px;">Quote Ready - Your Approval Needed</p>
                    <p style="color:var(--paper-dim); font-size:14px; margin-bottom:16px;">@job.ServiceRequested</p>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px;">
                        <div style="background:#e6f7ec; border-radius:6px; padding:14px;">
                            <div style="font-family:'Space Mono',monospace; font-size:10px; text-transform:uppercase; letter-spacing:0.5px; color:#1a7a3f; margin-bottom:4px;">If You Approve</div>
                            <div style="font-family:'Anton',sans-serif; font-size:20px; color:#1a7a3f;">R@(job.EstimatedTotalIfApproved.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</div>
                            <div style="font-size:11px; color:var(--paper-dim); margin-top:4px;">Repair + parts, plus diagnostic fee at 30% off</div>
                        </div>
                        <div style="background:#fdeceb; border-radius:6px; padding:14px;">
                            <div style="font-family:'Space Mono',monospace; font-size:10px; text-transform:uppercase; letter-spacing:0.5px; color:#b23b32; margin-bottom:4px;">If You Decline</div>
                            <div style="font-family:'Anton',sans-serif; font-size:20px; color:#b23b32;">R@(job.EstimatedTotalIfDeclined.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</div>
                            <div style="font-size:11px; color:var(--paper-dim); margin-top:4px;">Diagnostic fee only, full price - no repair done</div>
                        </div>
                    </div>

                    @if (job.EstimatedHours.HasValue)
                    {
                        <p style="color:var(--paper-dim); font-size:13px; margin-bottom:16px;">
                            Estimated repair time once approved: @job.EstimatedHours.Value.ToString("0.#") hour(s)
                        </p>
                    }

                    <p style="font-size:13px; color:var(--paper-dim); margin:16px 0 8px;">
                        By signing below, you confirm you either <strong>agree</strong> to this quote and want the repair to go ahead, or you're <strong>declining</strong> and will collect the vehicle as-is.
                    </p>

                    <div style="background:#ffffff; border:1px solid var(--steel-dim); border-radius:6px; overflow:hidden; max-width:420px;">
                        <canvas id="sigCanvas-@job.Id" width="420" height="150" style="display:block; cursor:crosshair; touch-action:none;"></canvas>
                    </div>
                    <button type="button" class="btn-ghost" style="margin-top:8px; padding:6px 14px; font-size:11px;" onclick="clearSignature(@job.Id)">Clear Signature</button>

                    <div class="form-row" style="max-width:420px; margin-top:14px;">
                        <label for="declineReason-@job.Id">Reason for declining (only needed if declining)</label>
                        <input type="text" id="declineReason-@job.Id" maxlength="500" placeholder="Optional" />
                    </div>

                    <div style="display:flex; gap:12px; margin-top:16px; flex-wrap:wrap;">
                        @using (Html.BeginForm("Approve", "JobCard", new { id = job.Id }, FormMethod.Post, new { id = "approveForm-" + job.Id }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="signatureDataUrl" id="approveSig-@job.Id" />
                            <button type="button" class="submit-btn" onclick="submitDecision(@job.Id, 'approve')">I Agree - Approve &amp; Sign</button>
                        }
                        @using (Html.BeginForm("Decline", "JobCard", new { id = job.Id }, FormMethod.Post, new { id = "declineForm-" + job.Id }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="signatureDataUrl" id="declineSig-@job.Id" />
                            <input type="hidden" name="declineReason" id="declineReasonHidden-@job.Id" />
                            <button type="button" class="btn-ghost" style="color:#ff6b6b; border-color:#ff6b6b;" onclick="submitDecision(@job.Id, 'decline')">I Disagree - Decline &amp; Sign</button>
                        }
                    </div>
                </div>
            }

            @if (job.Status == GarageJobCards.Models.JobStatus.ReadyForPickup)
            {
                <p style="margin-top:10px; color:var(--ice); font-family:'Oswald',sans-serif; text-transform:uppercase; letter-spacing:0.5px;">
                    Ready for pickup - bring your ID and this job number.
                </p>

                if (job.ManagerSignedByUserId != null)
                {
                    <a href="@Url.Action("Quotation","JobCard", new { id = job.Id })" class="submit-btn" style="text-decoration:none; display:inline-block; margin-top:12px;">View Quotation</a>
                }
                else
                {
                    <p style="color:var(--paper-dim); font-size:13px; margin-top:8px;">Your quotation is being finalized - check back shortly.</p>
                }
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        var pads = {};

        function initSignaturePad(jobId) {
            var canvas = document.getElementById("sigCanvas-" + jobId);
            if (!canvas) return;
            var ctx = canvas.getContext("2d");
            ctx.strokeStyle = "#16202e";
            ctx.lineWidth = 2;
            ctx.lineCap = "round";
            var drawing = false;

            function getPos(e) {
                var rect = canvas.getBoundingClientRect();
                var x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
                var y = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
                return { x: x, y: y };
            }

            function start(e) {
                drawing = true;
                var pos = getPos(e);
                ctx.beginPath();
                ctx.moveTo(pos.x, pos.y);
                e.preventDefault();
            }
            function move(e) {
                if (!drawing) return;
                var pos = getPos(e);
                ctx.lineTo(pos.x, pos.y);
                ctx.stroke();
                e.preventDefault();
            }
            function end() { drawing = false; }

            canvas.addEventListener("mousedown", start);
            canvas.addEventListener("mousemove", move);
            canvas.addEventListener("mouseup", end);
            canvas.addEventListener("mouseleave", end);
            canvas.addEventListener("touchstart", start);
            canvas.addEventListener("touchmove", move);
            canvas.addEventListener("touchend", end);

            pads[jobId] = canvas;
        }

        function clearSignature(jobId) {
            var canvas = pads[jobId];
            if (!canvas) return;
            var ctx = canvas.getContext("2d");
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        }

        function isCanvasBlank(canvas) {
            var blank = document.createElement("canvas");
            blank.width = canvas.width;
            blank.height = canvas.height;
            return canvas.toDataURL() === blank.toDataURL();
        }

        function submitDecision(jobId, decision) {
            var canvas = pads[jobId];
            if (!canvas || isCanvasBlank(canvas)) {
                alert("Please sign in the box first.");
                return;
            }
            var dataUrl = canvas.toDataURL("image/png");

            if (decision === "approve") {
                document.getElementById("approveSig-" + jobId).value = dataUrl;
                document.getElementById("approveForm-" + jobId).submit();
            } else {
                document.getElementById("declineSig-" + jobId).value = dataUrl;
                var reason = document.getElementById("declineReason-" + jobId);
                document.getElementById("declineReasonHidden-" + jobId).value = reason ? reason.value : "";
                document.getElementById("declineForm-" + jobId).submit();
            }
        }

        document.querySelectorAll("canvas[id^='sigCanvas-']").forEach(function (c) {
            var jobId = c.id.replace("sigCanvas-", "");
            initSignaturePad(jobId);
        });
    </script>
}
