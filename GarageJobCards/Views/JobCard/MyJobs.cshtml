@model IEnumerable<GarageJobCards.Models.JobCard>
@using System.Linq
@{
    ViewData["Title"] = "My Jobs";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var jobsNeedingReport = ViewBag.JobsNeedingReport as System.Collections.Generic.List<GarageJobCards.Models.JobCard>;
    var reportsByJobId = ViewBag.ReportsByJobId as System.Collections.Generic.Dictionary<int, GarageJobCards.Models.DiagnosticReport>;
}

<div class="page-head">
    <h1>My Jobs</h1>
    <p>Jobs assigned to you right now.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <p style="color:#ff6b6b; margin-bottom:20px;">@TempData["Error"]</p>
}

@if (jobsNeedingReport != null && jobsNeedingReport.Any())
{
    <div class="form-card" style="max-width:none; margin-bottom:24px; border-color:#e0a942; background:rgba(224,169,66,0.08);">
        <h3 style="font-family:'Oswald',sans-serif; text-transform:uppercase; font-size:14px; color:#e0a942; margin-bottom:14px;">
            Diagnostic Reports Needed (@jobsNeedingReport.Count)
        </h3>
        <div style="display:flex; flex-direction:column; gap:12px;">
            @foreach (var job in jobsNeedingReport)
            {
                var existing = reportsByJobId != null && reportsByJobId.ContainsKey(job.Id) ? reportsByJobId[job.Id] : null;
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; background:var(--oil); border-radius:6px; padding:14px 16px;">
                    <div>
                        <strong>@job.JobNumber</strong> - @job.Customer.FullName - @job.Vehicle.Make @job.Vehicle.Model
                        @if (existing != null && existing.Status == GarageJobCards.Models.DiagnosticReportStatus.NeedsRevision)
                        {
                            <div style="color:#dc4747; font-size:12px; margin-top:4px;">Sent back by Manager: @existing.ManagerNotes</div>
                        }
                    </div>
                    <a href="@Url.Action("WriteDiagnosticReport", new { id = job.Id })" class="btn-ghost" style="text-decoration:none; padding:8px 16px; font-size:12px;">
                        @(existing != null ? "Revise Report" : "Write Report")
                    </a>
                </div>
            }
        </div>
    </div>
}

@if (!Model.Any())
{
    <p style="color:var(--paper-dim);">No active jobs assigned to you right now.</p>
}

<div style="display:flex; flex-direction:column; gap:16px;">
    @foreach (var job in Model)
    {
        <div class="form-card" style="max-width:none;">
            <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:10px;">
                <h3 style="font-family:'Oswald',sans-serif; text-transform:uppercase; font-size:16px;">@job.JobNumber - @job.Vehicle.Make @job.Vehicle.Model</h3>
                <span class="status-badge status-@job.Status">@GarageJobCards.Models.JobCard.StatusLabel(job.Status)</span>
            </div>
            <p style="color:var(--paper-dim); font-size:14px; margin-bottom:12px;">@job.ServiceRequested</p>

            <div class="form-grid-2">
                <div class="form-row">
                    <label for="hours-@job.Id">Estimated hours</label>
                    <input type="number" id="hours-@job.Id" step="0.1" min="0.1" max="500" value="@job.EstimatedHours" onchange="updateEstimate(@job.Id)" />
                </div>
                <div class="form-row">
                    <label for="amount-@job.Id">Quoted amount (R)</label>
                    <input type="number" id="amount-@job.Id" step="0.01" min="0.01" max="500000" value="@job.EstimateAmount" onchange="updateEstimate(@job.Id)" />
                </div>
            </div>

            <div class="form-row">
                <label for="status-@job.Id">Status</label>
                <select id="status-@job.Id" onchange="updateStatus(@job.Id, this.value)">
                    @foreach (var s in Enum.GetValues(typeof(GarageJobCards.Models.JobStatus)).Cast<GarageJobCards.Models.JobStatus>())
                    {
                        var selectedAttr = job.Status == s ? "selected=\"selected\"" : "";
                        @Html.Raw("<option value=\"" + s + "\" " + selectedAttr + ">" + GarageJobCards.Models.JobCard.StatusLabel(s) + "</option>")
                    }
                </select>
            </div>

            <a href="@Url.Action("Details", new { id = job.Id })" style="color:var(--ice); font-size:13px;">View full job card</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateEstimate(jobId) {
            var hours = document.getElementById("hours-" + jobId).value;
            var amount = document.getElementById("amount-" + jobId).value;
            fetch("/JobCard/UpdateEstimate", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "id=" + jobId + "&hours=" + encodeURIComponent(hours) + "&amount=" + encodeURIComponent(amount)
            })
            .then(function (r) { return r.json(); })
            .then(function (result) {
                if (!result.success) alert(result.message || "Could not save the estimate.");
            });
        }

        function updateStatus(jobId, status) {
            fetch("/JobCard/UpdateStatus", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "id=" + jobId + "&status=" + encodeURIComponent(status)
            })
            .then(function (r) { return r.json(); })
            .then(function (result) {
                if (!result.success) alert(result.message || "Could not update status.");
                else location.reload();
            });
        }
    </script>
}
