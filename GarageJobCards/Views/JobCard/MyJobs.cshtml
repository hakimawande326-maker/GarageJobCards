@model IEnumerable<GarageJobCards.Models.JobCard>
@{
    ViewData["Title"] = "My Jobs";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>My Jobs</h1>
    <p>Jobs currently assigned to you. Update the status as you work through each one.</p>
</div>

@if (!Model.Any())
{
    <p style="color:var(--paper-dim);">No jobs assigned to you right now.</p>
}

<div style="display:flex; flex-direction:column; gap:16px;">
    @foreach (var job in Model)
    {
        <div class="form-card" style="max-width:none;">
            <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:14px; align-items:flex-start;">
                <div>
                    <div style="font-family:'Space Mono',monospace; font-size:12px; color:var(--ice);">@job.JobNumber</div>
                    <h3 style="font-family:'Oswald',sans-serif; text-transform:uppercase; margin:6px 0 4px; font-size:18px;">
                        @job.Vehicle.Make @job.Vehicle.Model &middot; @job.Vehicle.PlateNumber
                    </h3>
                    <div style="color:var(--paper-dim); font-size:13px;">@job.Customer.FullName</div>
                </div>
                <span class="status-badge status-@job.Status">@GarageJobCards.Models.JobCard.StatusLabel(job.Status)</span>
            </div>

            <p style="color:var(--paper-dim); font-size:14px; margin:16px 0;">@job.ServiceRequested</p>

            <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:14px;">
                <select class="status-select" data-job-id="@job.Id" style="background:var(--oil); color:var(--paper); border:1px solid var(--steel-dim); padding:10px 14px; border-radius:4px; font-family:'Inter',sans-serif; font-size:13px;">
                    @foreach (var s in GarageJobCards.Models.JobCard.TimelineOrder)
                    {
                        var selected = job.Status == s ? "selected=\"selected\"" : "";
                        @Html.Raw("<option value=\"" + s + "\" " + selected + ">" + GarageJobCards.Models.JobCard.StatusLabel(s) + "</option>")
                    }
                </select>
                <a href="@Url.Action("Details", new { id = job.Id })" class="btn-ghost" style="text-decoration:none; padding:10px 18px; font-size:12px;">View Job Card</a>
                <span class="save-note" data-job-id="@job.Id" style="font-size:12px; color:var(--ice); display:none;">Saved</span>
            </div>

            <div style="display:flex; gap:20px; align-items:flex-end; flex-wrap:wrap; border-top:1px dashed var(--steel-dim); padding-top:14px;">
                <div>
                    <label style="display:block; font-family:'Oswald',sans-serif; font-size:12px; letter-spacing:1px; text-transform:uppercase; color:var(--steel); margin-bottom:6px;">
                        Time estimate (hrs)
                    </label>
                    <input type="number" step="0.5" min="0" class="estimate-input" data-job-id="@job.Id"
                           value="@job.EstimatedHours"
                           style="width:90px; background:var(--oil); color:var(--paper); border:1px solid var(--steel-dim); padding:8px 10px; border-radius:4px; font-family:'Space Mono',monospace; font-size:13px;" />
                </div>
                <div>
                    <label style="display:block; font-family:'Oswald',sans-serif; font-size:12px; letter-spacing:1px; text-transform:uppercase; color:var(--steel); margin-bottom:6px;">
                        Quoted amount (R, max 500,000)
                    </label>
                    <input type="number" step="0.01" min="0" max="500000" class="amount-input" data-job-id="@job.Id"
                           value="@job.EstimateAmount"
                           placeholder="Leave blank until diagnosed"
                           style="width:170px; background:var(--oil); color:var(--paper); border:1px solid var(--steel-dim); padding:8px 10px; border-radius:4px; font-family:'Space Mono',monospace; font-size:13px;" />
                </div>
                <button type="button" class="btn-ghost estimate-save" data-job-id="@job.Id" style="padding:8px 16px; font-size:12px;">Save</button>
                @if (job.EstimatedCompletionUtc.HasValue)
                {
                    <span style="font-family:'Space Mono',monospace; font-size:12px; color:var(--ice);">
                        Est. done: @job.EstimatedCompletionUtc.Value.ToLocalTime().ToString("dd MMM, HH:mm")
                    </span>
                }
                <span class="estimate-save-note" data-job-id="@job.Id" style="font-size:12px; color:var(--ice); display:none;">Saved</span>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".status-select").forEach(function (select) {
            select.addEventListener("change", function () {
                var jobId = select.getAttribute("data-job-id");
                var note = document.querySelector('.save-note[data-job-id="' + jobId + '"]');

                fetch("/JobCard/UpdateStatus", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: "id=" + encodeURIComponent(jobId) + "&status=" + encodeURIComponent(select.value)
                })
                .then(function (r) { return r.json(); })
                .then(function (result) {
                    if (result.success) {
                        note.style.display = "inline";
                        setTimeout(function () { note.style.display = "none"; }, 1800);
                    } else {
                        alert(result.message || "Could not update this job.");
                    }
                })
                .catch(function () { alert("Network error - status not saved."); });
            });
        });

        document.querySelectorAll(".estimate-save").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var jobId = btn.getAttribute("data-job-id");
                var hoursInput = document.querySelector('.estimate-input[data-job-id="' + jobId + '"]');
                var amountInput = document.querySelector('.amount-input[data-job-id="' + jobId + '"]');
                var note = document.querySelector('.estimate-save-note[data-job-id="' + jobId + '"]');
                var hours = hoursInput.value;
                var amount = amountInput.value;

                if (amount && parseFloat(amount) > 500000) {
                    alert("Quoted amount can't exceed R500,000.");
                    return;
                }

                if (!hours && !amount) {
                    alert("Enter an hours estimate, a quoted amount, or both.");
                    return;
                }

                var body = "id=" + encodeURIComponent(jobId);
                if (hours) body += "&hours=" + encodeURIComponent(hours);
                if (amount) body += "&amount=" + encodeURIComponent(amount);

                fetch("/JobCard/UpdateEstimate", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: body
                })
                .then(function (r) { return r.json(); })
                .then(function (result) {
                    if (result.success) {
                        note.style.display = "inline";
                        note.textContent = "Saved - reloading...";
                        setTimeout(function () { window.location.reload(); }, 600);
                    } else {
                        alert(result.message || "Could not save the estimate.");
                    }
                })
                .catch(function () { alert("Network error - estimate not saved."); });
            });
        });
    </script>
}
