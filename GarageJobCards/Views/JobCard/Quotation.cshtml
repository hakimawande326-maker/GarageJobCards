@model GarageJobCards.Models.JobCard
@{
    ViewData["Title"] = "Quotation " + Model.QuotationNumber;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var diagnosticReport = ViewBag.DiagnosticReport as GarageJobCards.Models.DiagnosticReport;
}

<div class="page-head no-print">
    <h1>@(Model.CustomerDeclined ? "Diagnostic Invoice" : "Quotation")</h1>
    <p>@Model.QuotationNumber</p>
</div>

<div class="ticket-page" style="max-width:600px;">
    <div class="ticket-top">
        <div>
            <h2>Phila's Auto Repair Shop</h2>
            <div class="job-number">J Section, Umlazi, Durban, 4066</div>
            <div class="job-number">+27 78 234 5566</div>
            <div class="job-number">VAT Reg: 4123456789</div>
        </div>
        <div style="text-align:right;">
            <div class="job-number">@(Model.CustomerDeclined ? "INVOICE" : "QUOTATION") @Model.QuotationNumber</div>
            <div class="job-number">Job @Model.JobNumber</div>
        </div>
    </div>

    <div class="ticket-grid">
        <div class="ticket-field">
            <div class="k">Customer</div>
            <div class="v">@Model.Customer.FullName</div>
        </div>
        <div class="ticket-field">
            <div class="k">Vehicle</div>
            <div class="v">@Model.Vehicle.Make @Model.Vehicle.Model (@Model.Vehicle.PlateNumber)</div>
        </div>
        <div class="ticket-field">
            <div class="k">Service Requested</div>
            <div class="v">@Model.ServiceRequested</div>
        </div>
    </div>

    @if (Model.CustomerDeclined)
    {
        <p style="font-family:'Inter',sans-serif; font-size:13px; color:#5a5650; margin-bottom:16px;">
            You declined this repair@(string.IsNullOrEmpty(Model.DeclineReason) ? "" : " (" + Model.DeclineReason + ")") - the diagnostic work was still carried out, so the diagnostic fee below applies in full.
        </p>
    }
    else
    {
        <p style="font-family:'Inter',sans-serif; font-size:13px; color:#5a5650; margin-bottom:16px;">
            You approved this repair - the diagnostic fee below reflects your 30% approval discount, folded into the total.
        </p>
    }

    <div style="border-top:2px dashed rgba(0,0,0,0.25); border-bottom:2px dashed rgba(0,0,0,0.25); padding:18px 0; margin-bottom:20px;">
        <table style="width:100%; font-family:'Space Mono',monospace; font-size:13px;">
            @if (!Model.CustomerDeclined)
            {
                <tr>
                    <td style="padding:3px 0; color:#7a756c; text-transform:uppercase; letter-spacing:0.5px;">Repair / Parts</td>
                    <td style="padding:3px 0; text-align:right;">R@(Model.SubtotalExclVat.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</td>
                </tr>
                <tr>
                    <td style="padding:3px 0; color:#7a756c; text-transform:uppercase; letter-spacing:0.5px;">Admin Fee</td>
                    <td style="padding:3px 0; text-align:right;">R@(GarageJobCards.Models.JobCard.AdminFee.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</td>
                </tr>
            }
            <tr>
                <td style="padding:3px 0; color:#7a756c; text-transform:uppercase; letter-spacing:0.5px;">
                    Diagnostic Fee@(!Model.CustomerDeclined ? " (30% off, approved)" : "")
                </td>
                <td style="padding:3px 0; text-align:right;">R@(Model.DiagnosticFeeCharged.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</td>
            </tr>
            <tr>
                <td style="padding:3px 0; color:#7a756c; text-transform:uppercase; letter-spacing:0.5px;">VAT (15%)</td>
                <td style="padding:3px 0; text-align:right;">R@(Model.VatAmount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</td>
            </tr>
            <tr>
                <td style="padding-top:10px; font-family:'Anton',sans-serif; font-size:16px; text-transform:uppercase;">Total Due</td>
                <td style="padding-top:10px; text-align:right; font-family:'Anton',sans-serif; font-size:22px;">R@(Model.TotalInclVat.ToString("N2", System.Globalization.CultureInfo.InvariantCulture))</td>
            </tr>
        </table>
    </div>

    @if (Model.ManagerSignedBy != null)
    {
        <div class="ticket-notes">
            <p style="font-size:12px; color:#7a756c;">Signed off by @Model.ManagerSignedBy.FullName on @Model.SignedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy")</p>
        </div>
    }
    else if (Model.CustomerDeclined)
    {
        <div class="ticket-notes">
            <p style="font-size:12px; color:#7a756c;">Declined and signed by customer on @Model.DeclinedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy")</p>
        </div>
    }
</div>

@if (Model.CustomerDeclined && diagnosticReport != null)
{
    <div class="form-card no-print" style="max-width:600px; margin:24px auto 0;">
        <h3 style="font-family:'Oswald',sans-serif; text-transform:uppercase; font-size:15px; margin-bottom:6px;">Diagnostic Findings</h3>
        <p style="color:var(--steel); font-family:'Space Mono',monospace; font-size:11px; margin-bottom:16px;">
            Prepared by @diagnosticReport.WrittenBy.FullName - @diagnosticReport.WrittenAtUtc.ToLocalTime().ToString("dd MMM yyyy")
        </p>
        <p style="color:var(--paper-dim); font-size:14px; line-height:1.7; white-space:pre-wrap;">@diagnosticReport.ReportText</p>
    </div>
}
else if (Model.CustomerDeclined)
{
    <div class="form-card no-print" style="max-width:600px; margin:24px auto 0;">
        <p style="color:var(--paper-dim); font-size:14px;">Your diagnostic findings report is being prepared and will appear here once ready.</p>
    </div>
}

<button onclick="window.print()" class="submit-btn print-btn no-print" style="margin-top:20px; display:block; margin-left:auto; margin-right:auto;">Print</button>
