@model IEnumerable<GarageJobCards.Models.Delivery>
@using System.Linq
@{
    ViewData["Title"] = "My Deliveries";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>My Deliveries</h1>
    <p>Deliveries assigned to you - open one on your phone to start sharing your location.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>@TempData["Success"]</span>
    </div>
}

@if (!Model.Any())
{
    <p style="color:var(--paper-dim);">No deliveries assigned to you right now.</p>
}

<div style="display:flex; flex-direction:column; gap:16px;">
    @foreach (var d in Model)
    {
        <div class="form-card" style="max-width:none;">
            <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:10px;">
                <h3 style="font-family:'Oswald',sans-serif; text-transform:uppercase; font-size:16px;">@d.DeliveryNumber</h3>
                <span class="status-badge" style="background:@(d.Status == GarageJobCards.Models.DeliveryStatus.OutForDelivery ? "linear-gradient(135deg, var(--blue), var(--blue-dim))" : "linear-gradient(135deg, #64748b, #4a5568)");">@GarageJobCards.Models.Delivery.StatusLabel(d.Status)</span>
            </div>
            <p style="color:var(--paper-dim); font-size:14px; margin-bottom:4px;">
                @d.Purchase.CustomerDisplayName
            </p>
            <p style="color:var(--paper-dim); font-size:13px; margin-bottom:16px;">@d.DeliveryAddress</p>

            <a href="@Url.Action("Drive", new { id = d.Id })" class="submit-btn" style="text-decoration:none; display:inline-block;">
                @(d.Status == GarageJobCards.Models.DeliveryStatus.Pending ? "Start Delivery" : "Continue Delivery")
            </a>
        </div>
    }
</div>
