@{
    ViewData["Title"] = "Link Expired";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>This Link Has Expired</h1>
    <p>Reset links only work for 1 hour, and only once.</p>
</div>

<div class="form-card" style="text-align:center;">
    <a href="@Url.Action("ForgotPassword","Account")" class="submit-btn" style="text-decoration:none; display:inline-block;">Request a New Link</a>
</div>
