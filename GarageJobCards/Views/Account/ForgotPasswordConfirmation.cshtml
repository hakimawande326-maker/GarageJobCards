@{
    ViewData["Title"] = "Check Your Email";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>Check Your Email</h1>
    <p>If that email is registered, a reset link is on its way.</p>
</div>

<div class="form-card">
    <div class="alert-success">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>The link expires in 1 hour. Check your spam folder if it doesn't show up in a minute or two.</span>
    </div>
    <a href="@Url.Action("Login","Account")" style="color:var(--ice); font-size:13px;">Back to log in</a>
</div>
