@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>Forgot Password</h1>
    <p>Enter the email your account is registered with, and we'll send you a reset link.</p>
</div>

<div class="form-card">
    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="form-row">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required="required" autofocus="autofocus" />
        </div>
        <button type="submit" class="submit-btn">Send Reset Link</button>
    }

    <p style="margin-top:20px; font-size:13px;">
        <a href="@Url.Action("Login","Account")" style="color:var(--ice);">Back to log in</a>
    </p>
</div>
