@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>Forgot Password</h1>
    <p>Enter your email and phone number - if they match an account, we'll text you a code.</p>
</div>

<div class="form-card">
    @if (ViewBag.Error != null)
    {
        <p style="color:#ff6b6b; margin-bottom:20px;">@ViewBag.Error</p>
    }
    @if (ViewBag.DebugError != null)
    {
        <div style="background:rgba(255,107,107,0.1); border:1px solid #ff6b6b; border-radius:6px; padding:16px; margin-bottom:20px; font-family:'Consolas',monospace; font-size:12px; white-space:pre-wrap; color:#ff6b6b;">
            DEBUG - actual error:<br />@ViewBag.DebugError
        </div>
    }

    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="form-row">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required="required" autofocus="autofocus" />
        </div>
        <div class="form-row">
            <label for="phone">Phone number</label>
            <input type="tel" id="phone" name="phone" required="required" maxlength="10" pattern="\d{10}" placeholder="0721234567" />
            <span style="color:var(--steel); font-size:11px; font-family:'Space Mono',monospace; display:block; margin-top:6px;">
                Must match the phone number on your account exactly.
            </span>
        </div>
        <button type="submit" class="submit-btn">Send Code</button>
    }

    <p style="margin-top:20px; font-size:13px;">
        <a href="@Url.Action("Login","Account")" style="color:var(--ice);">Back to log in</a>
    </p>
</div>