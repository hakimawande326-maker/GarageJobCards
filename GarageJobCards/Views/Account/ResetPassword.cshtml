@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>Set a New Password</h1>
    <p>Choose a new password for your account.</p>
</div>

<div class="form-card">
    @if (ViewBag.Error != null)
    {
        <p style="color:#ff6b6b; margin-bottom:20px;">@ViewBag.Error</p>
    }

    @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@ViewBag.Token" />

        <div class="form-row">
            <label for="newPassword">New password</label>
            <input type="password" id="newPassword" name="newPassword" required="required" minlength="6" autofocus="autofocus" />
        </div>
        <div class="form-row">
            <label for="confirmPassword">Confirm new password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" required="required" minlength="6" />
        </div>
        <button type="submit" class="submit-btn">Update Password</button>
    }
</div>
