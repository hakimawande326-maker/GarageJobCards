@{
    ViewData["Title"] = "Log In";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string selectedRole = ViewBag.SelectedRole ?? "Receptionist";
}

<div class="login-3d-wrap">
    <div class="login-3d-canvas-holder">
        <canvas id="loginCanvas"></canvas>
    </div>

    <div class="page-head" style="position:relative; z-index:1;">
        <h1>Log In</h1>
        <p>Pick your role, then sign in.</p>
    </div>

    <div class="form-card login-card">
        @if (ViewBag.Error != null)
        {
            <p style="color:#ff6b6b; margin-bottom:20px;">@ViewBag.Error</p>
        }

        <div class="role-switch" id="roleSwitch">
            <div class="role-switch-highlight" id="roleHighlight"></div>
            <button type="button" class="role-option" data-role="Receptionist">Receptionist</button>
            <button type="button" class="role-option" data-role="Manager">Manager</button>
            <button type="button" class="role-option" data-role="Mechanic">Mechanic</button>
            <button type="button" class="role-option" data-role="Customer">Customer</button>
        </div>

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <input type="hidden" name="role" id="roleInput" value="@selectedRole" />

            <div class="form-row">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required="required" autofocus="autofocus" />
            </div>
            <div class="form-row">
                <label for="password">Password</label>
                <div style="position:relative;">
                    <input type="password" id="password" name="password" required="required" style="width:100%; padding-right:70px; box-sizing:border-box;" />
                    <button type="button" id="togglePassword" style="position:absolute; right:8px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:var(--steel); font-family:'Space Mono',monospace; font-size:11px; text-transform:uppercase; padding:4px 6px;">Show</button>
                </div>
            </div>
            <button type="submit" class="submit-btn">Log In as <span id="roleLabelInBtn">@selectedRole</span></button>
        }

        <p style="margin-top:16px; font-size:13px;">
            <a href="@Url.Action("ForgotPassword","Account")" style="color:var(--ice);">Forgot your password?</a>
        </p>

        <p style="color:var(--steel); font-size:12px; margin-top:22px; font-family:'Space Mono',monospace;">
            Demo accounts (password: Password1!) - reception@philasauto.co.za - manager@philasauto.co.za -
            sdube@philasauto.co.za - thandeka@example.com
        </p>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var switchEl = document.getElementById("roleSwitch");
            var highlight = document.getElementById("roleHighlight");
            var input = document.getElementById("roleInput");
            var label = document.getElementById("roleLabelInBtn");
            var buttons = switchEl.querySelectorAll(".role-option");

            function selectRole(button, animate) {
                buttons.forEach(function (b) { b.classList.remove("active"); });
                button.classList.add("active");
                input.value = button.getAttribute("data-role");
                label.textContent = button.getAttribute("data-role");

                var rect = button.getBoundingClientRect();
                var containerRect = switchEl.getBoundingClientRect();
                if (!animate) highlight.style.transition = "none";
                highlight.style.width = rect.width + "px";
                highlight.style.transform = "translateX(" + (rect.left - containerRect.left) + "px)";
                if (!animate) {
                    void highlight.offsetWidth;
                    highlight.style.transition = "";
                }
            }

            buttons.forEach(function (button) {
                button.addEventListener("click", function () { selectRole(button, true); });
            });

            var initial = Array.prototype.find.call(buttons, function (b) {
                return b.getAttribute("data-role") === input.value;
            }) || buttons[0];

            window.addEventListener("load", function () { selectRole(initial, false); });
            selectRole(initial, false);
        })();

        (function () {
            var toggle = document.getElementById("togglePassword");
            var pwd = document.getElementById("password");
            toggle.addEventListener("click", function () {
                if (pwd.type === "password") {
                    pwd.type = "text";
                    toggle.textContent = "Hide";
                } else {
                    pwd.type = "password";
                    toggle.textContent = "Show";
                }
            });
        })();
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        (function () {
            var canvas = document.getElementById("loginCanvas");
            if (!canvas || typeof THREE === "undefined") return;

            var holder = canvas.parentElement;
            var width = holder.clientWidth || 800;
            var height = holder.clientHeight || 340;

            var scene = new THREE.Scene();
            var camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
            camera.position.set(0, 0, 14);

            var renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });
            renderer.setSize(width, height, false);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

            scene.add(new THREE.AmbientLight(0x2a3548, 1.2));
            var key = new THREE.DirectionalLight(0x7dd3fc, 0.8);
            key.position.set(4, 5, 6);
            scene.add(key);

            var shapes = [];
            var geometries = [
                new THREE.IcosahedronGeometry(1.1, 0),
                new THREE.TorusGeometry(0.9, 0.3, 8, 24),
                new THREE.OctahedronGeometry(1, 0),
                new THREE.BoxGeometry(1.3, 1.3, 1.3),
                new THREE.TetrahedronGeometry(1.2, 0)
            ];
            var wireMat = new THREE.MeshBasicMaterial({ color: 0x7dd3fc, wireframe: true, transparent: true, opacity: 0.5 });
            var solidMat = new THREE.MeshStandardMaterial({ color: 0x2f6fed, metalness: 0.5, roughness: 0.3, transparent: true, opacity: 0.25 });

            for (var i = 0; i < geometries.length; i++) {
                var group = new THREE.Group();
                var wire = new THREE.Mesh(geometries[i], wireMat);
                var solid = new THREE.Mesh(geometries[i], solidMat);
                group.add(solid);
                group.add(wire);

                group.position.set(
                    (i - (geometries.length - 1) / 2) * 3.2,
                    (i % 2 === 0 ? 1 : -1) * 0.6,
                    (i % 3) * -1.5
                );
                group.userData.rotSpeedX = 0.15 + Math.random() * 0.2;
                group.userData.rotSpeedY = 0.2 + Math.random() * 0.25;
                group.userData.floatOffset = Math.random() * Math.PI * 2;

                scene.add(group);
                shapes.push(group);
            }

            var clock = 0;
            function animate() {
                requestAnimationFrame(animate);
                clock += 0.016;

                shapes.forEach(function (g) {
                    g.rotation.x += g.userData.rotSpeedX * 0.01;
                    g.rotation.y += g.userData.rotSpeedY * 0.01;
                    g.position.y += Math.sin(clock + g.userData.floatOffset) * 0.002;
                });

                renderer.render(scene, camera);
            }
            animate();

            window.addEventListener("resize", function () {
                var w = holder.clientWidth, h = holder.clientHeight;
                if (!w || !h) return;
                camera.aspect = w / h;
                camera.updateProjectionMatrix();
                renderer.setSize(w, h, false);
            });
        })();
    </script>
}