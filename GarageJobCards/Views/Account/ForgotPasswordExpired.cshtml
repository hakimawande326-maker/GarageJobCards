@{
    ViewData["Title"] = "Code Expired";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
    <h1>That Code Expired</h1>
    <p>Codes are only valid for 1 minute 50 seconds. Request a fresh one.</p>
</div>

<div class="form-card" style="text-align:center;">
    <a href="@Url.Action("ForgotPassword","Account")" class="submit-btn" style="text-decoration:none; display:inline-block;">Request a New Code</a>
</div>