@model IEnumerable<GarageJobCards.Models.Product>
@using System.Linq
@{
    ViewData["Title"] = "Parts Catalog";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as System.Collections.Generic.List<GarageJobCards.Models.ProductCategory>;
    var selected = ViewBag.SelectedCategory as GarageJobCards.Models.ProductCategory?;
    var knownMakes = ViewBag.KnownMakes as System.Collections.Generic.List<string>;
    string currentMake = ViewBag.Make as string;
    string currentModel = ViewBag.Model as string;
    bool vehicleSelected = ViewBag.VehicleSelected == true;
    bool isManager = Session["UserRole"] != null && Session["UserRole"].ToString() == "Manager";
}

<div class="page-head" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px;">
    <div>
        <h1>Parts Catalog</h1>
        <p>@Model.Count() product(s)@(selected.HasValue ? " in " + GarageJobCards.Models.Product.CategoryLabel(selected.Value) : "").</p>
    </div>
    <div style="display:flex; gap:12px;">
        <a href="@Url.Action("Purchase")" class="submit-btn" style="text-decoration:none; display:inline-block;">+ New Sale</a>
        @if (isManager)
        {
            <a href="@Url.Action("Create")" class="btn-ghost" style="text-decoration:none; display:inline-block;">+ Add Product</a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-success">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>@TempData["Success"]</span>
    </div>
}

<div class="form-card" style="max-width:none; margin-bottom:24px;">
    <h3 style="font-family:'Oswald',sans-serif; text-transform:uppercase; font-size:14px; margin-bottom:14px; color:var(--paper-dim);">
        Which vehicle are you shopping for?
    </h3>
    @using (Html.BeginForm("Index", "Product", FormMethod.Get))
    {
        if (selected.HasValue)
        {
            @Html.Hidden("category", selected.Value)
        }
        <div style="display:flex; gap:14px; flex-wrap:wrap; align-items:flex-end;">
            <div class="form-row" style="margin-bottom:0; min-width:180px;">
                <label for="make">Make</label>
                <input type="text" name="make" id="make" value="@currentMake" list="makeSuggestions" placeholder="e.g. Toyota" />
                <datalist id="makeSuggestions">
                    @if (knownMakes != null)
                    {
                        foreach (var m in knownMakes)
                        {
                            @Html.Raw("<option value=\"" + m + "\"></option>")
                        }
                    }
                </datalist>
            </div>
            <div class="form-row" style="margin-bottom:0; min-width:180px;">
                <label for="model">Model</label>
                <input type="text" name="model" id="model" value="@currentModel" placeholder="e.g. Hilux (optional)" />
            </div>
            <button type="submit" class="submit-btn" style="height:44px;">Check Fitment</button>
            @if (vehicleSelected)
            {
                <a href="@Url.Action("Index", new { category = selected })" class="btn-ghost" style="height:44px; display:flex; align-items:center; text-decoration:none;">Clear</a>
            }
        </div>
    }
    @if (vehicleSelected)
    {
        <p style="color:var(--ice); font-size:13px; margin-top:14px;">
            Showing fitment for: <strong>@currentMake @currentModel</strong>
        </p>
    }
</div>

<div class="board-toolbar">
    <a href="@Url.Action("Index", new { make = currentMake, model = currentModel })" class="btn-ghost" style="text-decoration:none; padding:9px 16px; font-size:12px; @(selected == null ? "border-color:var(--blue); color:var(--blue);" : "")">All Categories</a>
    @foreach (var cat in categories)
    {
        var active = selected.HasValue && selected.Value == cat;
        <a href="@Url.Action("Index", new { category = cat, make = currentMake, model = currentModel })" class="btn-ghost" style="text-decoration:none; padding:9px 16px; font-size:12px; @(active ? "border-color:var(--blue); color:var(--blue);" : "")">@GarageJobCards.Models.Product.CategoryLabel(cat)</a>
    }
</div>

@if (!Model.Any())
{
    <p style="color:var(--paper-dim);">No products in this category yet.</p>
}
else
{
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px, 1fr)); gap:18px;">
        @foreach (var p in Model)
        {
            bool fits = !vehicleSelected || p.FitsVehicle(currentMake, currentModel);
            <div class="form-card" style="max-width:none; padding:0; overflow:hidden;">
                <div style="width:100%; height:160px; background:var(--asphalt); display:flex; align-items:center; justify-content:center; overflow:hidden;">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@Url.Content("~" + p.ImageUrl)" alt="@p.Name" style="width:100%; height:100%; object-fit:cover;" />
                    }
                    else
                    {
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--steel)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                    }
                </div>
                <div style="padding:16px;">
                    @if (vehicleSelected)
                    {
                        if (fits)
                        {
                            <span style="display:inline-block; background:#e6f7ec; color:#1a7a3f; font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.5px; text-transform:uppercase; padding:3px 9px; border-radius:12px; margin-bottom:8px;">Fits @currentMake @currentModel</span>
                        }
                        else
                        {
                            <span style="display:inline-block; background:#fdeceb; color:#b23b32; font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.5px; text-transform:uppercase; padding:3px 9px; border-radius:12px; margin-bottom:8px;">May not fit @currentMake @currentModel</span>
                        }
                    }
                    <h4 style="font-family:'Oswald',sans-serif; font-size:15px; text-transform:uppercase; margin-bottom:4px;">@p.Name</h4>
                    <p style="color:var(--paper-dim); font-size:12.5px; line-height:1.5; margin-bottom:10px; min-height:36px;">@(string.IsNullOrEmpty(p.Description) ? "No description." : p.Description)</p>
                    <div style="display:flex; justify-content:space-between; align-items:center; font-family:'Space Mono',monospace; font-size:11px; color:var(--steel); margin-bottom:10px;">
                        <span>@GarageJobCards.Models.Product.CategoryLabel(p.Category)</span>
                        <span>@(p.StockQuantity <= 3 ? "Only " + p.StockQuantity + " left" : p.StockQuantity + " in stock")</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-family:'Anton',sans-serif; font-size:18px;">R@(p.Price.ToString("N2"))</span>
                        @if (isManager)
                        {
                            <a href="@Url.Action("Edit", new { id = p.Id })" class="btn-ghost" style="text-decoration:none; padding:6px 12px; font-size:11px;">Edit</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
