@model IEnumerable<GarageJobCards.Models.Product>
@using System.Linq
@{
    ViewData["Title"] = "Shop Parts";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var myVehicles = ViewBag.MyVehicles as System.Collections.Generic.List<GarageJobCards.Models.Vehicle>;
    var selectedVehicle = ViewBag.SelectedVehicle as GarageJobCards.Models.Vehicle;
    string manualMake = ViewBag.ManualMake as string;
    string manualModel = ViewBag.ManualModel as string;
    bool showAll = ViewBag.ShowAll == true;
    bool hasVehicleContext = ViewBag.HasVehicleContext == true;
    var categories = ViewBag.Categories as System.Collections.Generic.List<GarageJobCards.Models.ProductCategory>;
    var selectedCategory = ViewBag.SelectedCategory as GarageJobCards.Models.ProductCategory?;

    string fitMake = selectedVehicle != null ? selectedVehicle.Make : manualMake;
    string fitModel = selectedVehicle != null ? selectedVehicle.Model : manualModel;
    string fitLabel = selectedVehicle != null ? "your " + selectedVehicle.Make + " " + selectedVehicle.Model : fitMake + " " + fitModel;
}

<div class="page-head" style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px;">
    <div>
        <h1>Shop Parts</h1>
        <p>Browse what we have in stock, then buy online or visit us at the counter.</p>
    </div>
    <a href="@Url.Action("Checkout","Product")" class="submit-btn" style="text-decoration:none; display:inline-block;">Buy Online</a>
</div>

<div class="form-card" style="max-width:none; margin-bottom:20px;">
    <h3 style="font-family:'Oswald',sans-serif; text-transform:uppercase; font-size:14px; margin-bottom:14px; color:var(--paper-dim);">
        Shopping for a specific vehicle, or just browsing?
    </h3>

    <div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px;">
        <a href="@Url.Action("Browse", new { showAll = true, category = selectedCategory })" class="btn-ghost" style="text-decoration:none; padding:10px 16px; font-size:12px; @(showAll ? "border-color:var(--blue); color:var(--blue);" : "")">Just Browsing Everything</a>

        @if (myVehicles != null && myVehicles.Any())
        {
            if (myVehicles.Count <= 5)
            {
                foreach (var v in myVehicles)
                {
                    bool active = selectedVehicle != null && selectedVehicle.Id == v.Id;
                    <a href="@Url.Action("Browse", new { vehicleId = v.Id, category = selectedCategory })" class="btn-ghost" style="text-decoration:none; padding:10px 16px; font-size:12px; @(active ? "border-color:var(--blue); color:var(--blue);" : "")">My @v.Make @v.Model</a>
                }
            }
        }
    </div>

    @if (myVehicles != null && myVehicles.Count > 5)
    {
        <div class="form-row" style="max-width:340px; margin-bottom:16px;">
            <label for="vehiclePicker">Pick from your @myVehicles.Count vehicles</label>
            <select id="vehiclePicker" onchange="if(this.value) window.location.href=this.value;">
                <option value="">-- Select a vehicle --</option>
                @foreach (var v in myVehicles)
                {
                    var url = Url.Action("Browse", new { vehicleId = v.Id, category = selectedCategory });
                    var selectedAttr = (selectedVehicle != null && selectedVehicle.Id == v.Id) ? "selected=\"selected\"" : "";
                    @Html.Raw("<option value=\"" + url + "\" " + selectedAttr + ">" + v.Make + " " + v.Model + " (" + v.PlateNumber + ")</option>")
                }
            </select>
            <span style="color:var(--steel); font-size:11px; font-family:'Space Mono',monospace; display:block; margin-top:6px;">
                Tip: click the list, then start typing a make or plate to jump straight to it.
            </span>
        </div>
    }

    <p style="color:var(--paper-dim); font-size:13px; margin-bottom:10px;">
        Shopping for a different car (not one of yours on file)? Type it in:
    </p>
    @using (Html.BeginForm("Browse", "Product", FormMethod.Get))
    {
        if (selectedCategory.HasValue)
        {
            @Html.Hidden("category", selectedCategory.Value)
        }
        <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
            <div class="form-row" style="margin-bottom:0; min-width:160px;">
                <label for="make">Make</label>
                <input type="text" name="make" id="make" value="@manualMake" placeholder="e.g. Ford" />
            </div>
            <div class="form-row" style="margin-bottom:0; min-width:160px;">
                <label for="model">Model</label>
                <input type="text" name="model" id="model" value="@manualModel" placeholder="e.g. Ranger" />
            </div>
            <button type="submit" class="submit-btn" style="height:44px;">Check Fitment</button>
        </div>
    }
</div>

@if (hasVehicleContext)
{
    <p style="color:var(--ice); font-size:13px; margin-bottom:16px;">
        Showing fitment for @fitLabel
    </p>
}
@if (showAll)
{
    <p style="color:var(--paper-dim); font-size:13px; margin-bottom:16px;">
        Showing the full catalog - no fitment filter applied.
    </p>
}

<div class="board-toolbar">
    <a href="@Url.Action("Browse", new { vehicleId = selectedVehicle != null ? selectedVehicle.Id : (int?)null, make = manualMake, model = manualModel, showAll = showAll })" class="btn-ghost" style="text-decoration:none; padding:9px 16px; font-size:12px; @(selectedCategory == null ? "border-color:var(--blue); color:var(--blue);" : "")">All Categories</a>
    @foreach (var cat in categories)
    {
        bool active = selectedCategory.HasValue && selectedCategory.Value == cat;
        <a href="@Url.Action("Browse", new { category = cat, vehicleId = selectedVehicle != null ? selectedVehicle.Id : (int?)null, make = manualMake, model = manualModel, showAll = showAll })" class="btn-ghost" style="text-decoration:none; padding:9px 16px; font-size:12px; @(active ? "border-color:var(--blue); color:var(--blue);" : "")">@GarageJobCards.Models.Product.CategoryLabel(cat)</a>
    }
</div>

@if (!Model.Any())
{
    <p style="color:var(--paper-dim);">No products in this category yet.</p>
}
else
{
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(240px, 1fr)); gap:18px;">
        @foreach (var p in Model)
        {
            bool fits = !hasVehicleContext || p.FitsVehicle(fitMake, fitModel);
            <div class="form-card" style="max-width:none; padding:0; overflow:hidden; @(hasVehicleContext && !fits ? "opacity:0.55;" : "")">
                <div style="width:100%; height:160px; background:var(--asphalt); display:flex; align-items:center; justify-content:center; overflow:hidden;">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@Url.Content("~" + p.ImageUrl)" alt="@p.Name" style="width:100%; height:100%; object-fit:cover;" />
                    }
                    else
                    {
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--steel)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                    }
                </div>
                <div style="padding:16px;">
                    @if (hasVehicleContext)
                    {
                        if (fits)
                        {
                            <span style="display:inline-block; background:#e6f7ec; color:#1a7a3f; font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.5px; text-transform:uppercase; padding:3px 9px; border-radius:12px; margin-bottom:8px;">Fits @fitLabel</span>
                        }
                        else
                        {
                            <span style="display:inline-block; background:#fdeceb; color:#b23b32; font-family:'Space Mono',monospace; font-size:10px; letter-spacing:0.5px; text-transform:uppercase; padding:3px 9px; border-radius:12px; margin-bottom:8px;">May not fit @fitLabel</span>
                        }
                    }
                    <h4 style="font-family:'Oswald',sans-serif; font-size:15px; text-transform:uppercase; margin-bottom:4px;">@p.Name</h4>
                    <p style="color:var(--paper-dim); font-size:12.5px; line-height:1.5; margin-bottom:10px; min-height:36px;">@(string.IsNullOrEmpty(p.Description) ? "No description." : p.Description)</p>
                    <div style="display:flex; justify-content:space-between; align-items:center; font-family:'Space Mono',monospace; font-size:11px; color:var(--steel); margin-bottom:10px;">
                        <span>@GarageJobCards.Models.Product.CategoryLabel(p.Category)</span>
                        <span>@(p.StockQuantity > 0 ? "In stock" : "Out of stock")</span>
                    </div>
                    <span style="font-family:'Anton',sans-serif; font-size:18px;">R@(p.Price.ToString("N2"))</span>
                </div>
            </div>
        }
    </div>
}

<div class="form-card" style="max-width:none; margin-top:24px; text-align:center;">
    <p style="color:var(--paper-dim); font-size:14px;">Ready to buy? <a href="@Url.Action("Checkout","Product")" style="color:var(--ice);">Check out online</a>, or call us on <strong>+27 78 234 5566</strong> / visit the shop.</p>
</div>
