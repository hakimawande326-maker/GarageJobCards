@model GarageJobCards.Models.AnalyticsViewModel
@using System.Linq
@{
 ViewData["Title"] = "Business Analytics";
 Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-head">
 <h1>Business Analytics</h1>
 <p>Live numbers across every job card, mechanic, and customer.</p>
</div>

<div class="stats" style="background:var(--panel); border:1px solid rgba(255,255,255,0.06); border-radius:8px; margin-bottom:36px;">
 <div class="stats-grid" style="max-width:none; padding:32px;">
 <div class="stat"><div class="num">@Model.TotalJobs</div><div class="label">Total Jobs (All Time)</div></div>
 <div class="stat"><div class="num">@Model.ActiveJobs</div><div class="label">Active Right Now</div></div>
 <div class="stat"><div class="num">@Model.CompletedJobs</div><div class="label">Completed</div></div>
 <div class="stat"><div class="num">R@(Model.TotalRevenue.ToString("N0"))</div><div class="label">Total Revenue</div></div>
 </div>
</div>

<div class="stats" style="background:var(--panel); border:1px solid rgba(255,255,255,0.06); border-radius:8px; margin-bottom:36px;">
 <div class="stats-grid" style="max-width:none; padding:32px;">
 <div class="stat"><div class="num">@(Model.AvgTurnaroundHours.ToString("N1"))h</div><div class="label">Avg. Turnaround</div></div>
 <div class="stat"><div class="num">@Model.TotalCustomers</div><div class="label">Registered Customers</div></div>
 <div class="stat"><div class="num">@Model.TotalVehicles</div><div class="label">Registered Vehicles</div></div>
 <div class="stat"><div class="num">@Model.TotalMechanics</div><div class="label">Mechanics on Staff</div></div>
 </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
 <div class="form-card" style="max-width:none;">
 <h3 style="font-family:'Oswald',sans-serif; text-transform:uppercase; font-size:16px; margin-bottom:18px; color:var(--steel);">Jobs by Status</h3>
 @foreach (var s in Model.StatusBreakdown)
 {
 <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 0; border-bottom:1px solid rgba(255,255,255,0.06);">
 <span class="status-badge status-@s.Status">@GarageJobCards.Models.JobCard.StatusLabel(s.Status)</span>
 <span style="font-family:'Space Mono',monospace; color:var(--paper);">@s.Count</span>
 </div>
 }
 @if (!Model.StatusBreakdown.Any())
 {
 <p style="color:var(--paper-dim); font-size:14px;">No job cards yet.</p>
 }
 </div>

 <div class="form-card" style="max-width:none;">
 <h3 style="font-family:'Oswald',sans-serif; text-transform:uppercase; font-size:16px; margin-bottom:18px; color:var(--steel);">Mechanic Performance</h3>
 @foreach (var m in Model.MechanicPerformance)
 {
 <div style="padding:10px 0; border-bottom:1px solid rgba(255,255,255,0.06);">
 <div style="display:flex; justify-content:space-between;">
 <span style="font-family:'Oswald',sans-serif; text-transform:uppercase; font-size:13px;">@m.Name</span>
 <span style="font-family:'Space Mono',monospace; font-size:12px; color:var(--ice);">@m.CompletedCount completed</span>
 </div>
 <div style="font-size:12px; color:var(--paper-dim); margin-top:4px;">@m.ActiveCount active right now</div>
 </div>
 }
 @if (!Model.MechanicPerformance.Any())
 {
 <p style="color:var(--paper-dim); font-size:14px;">No mechanics registered yet.</p>
 }
 </div>
</div>
